{
	"operand-patterns": {
		"mem-operand": [
			{"operand": "[ebp%offset%]", "expression": "STACKVAR(%offset%, %size%)"},
			{"operand": "[%eax-ecx-edx%]", "expression": "ACCESS(REGVALUE(%eax-ecx-edx%), 0, %size%)"},
			{"operand": "[%eax-ecx-edx%%offset%]", "expression": "ACCESS(REGVALUE(%eax-ecx-edx%), %offset%, %size%)"},
			{"operand": "[%label%]", "expression": "ACCESS(GLOBAL(%label%), 0, %size%)"},
			{"operand": "[%eax-ecx-edx-base%+%eax-ecx-edx-index%]", "expression": "ACCESS(ARRPTR(REGVALUE(%eax-ecx-edx-base%), 1, REGVALUE(%eax-ecx-edx-index%), 0), 0, %size%)"},
			{"operand": "[%eax-ecx-edx-base%+%eax-ecx-edx-index%%offset%]", "expression": "ACCESS(ARRPTR(REGVALUE(%eax-ecx-edx-base%), 1, REGVALUE(%eax-ecx-edx-index%), %offset%), 0, %size%)"}
		],
		"reg-operand": [
			{"operand": "%al-cl-dl%", "expression": "%al-cl-dl%"},
			{"operand": "%ax-cx-dx%", "expression": "%ax-cx-dx%"},
			{"operand": "%eax-ecx-edx%", "expression": "%eax-ecx-edx%"}
		],
		"src-operand": [
			{"operand": "%mem-operand%", "expression": "%mem-operand%"},
			{"operand": "%reg-operand%", "expression": "REGVALUE(%reg-operand%)"},
			{"operand": "%hex%", "expression": "%hex%"},
			{"operand": "%label%", "expression": "GLOBAL(%label%)"}
		],
		"src-operand-left": [
			{"operand": "%src-operand%", "expression": "%src-operand%"}
		],
		"src-operand-right": [
			{"operand": "%src-operand%", "expression": "%src-operand%"}
		]
	},
	"instructions-patterns": [
	{
		"instructions": [
			{"push": ["[esp+004h]"]},
			{"call": ["%label%"]},
			{"neg":  ["eax"]},
			{"sbb":  ["eax", "eax"]},
			{"pop":  ["ecx"]},
			{"neg":  ["eax"]},
			{"dec":  ["eax"]},
			{"ret":  []}
		],
		"action": {"standard-proc": {"name": "atexit_%label%"}}
	},
	{
		"instructions": [
			{"push": ["ebp"]},
			{"mov":  ["ebp", "esp"]},
			{"push": ["ecx"]}
		],
		"action": {"prolog": {"allocated": "4"}}
	},
	{
		"instructions": [
			{"push": ["ebp"]},
			{"mov":  ["ebp", "esp"]}
		],
		"action": {"prolog": {"allocated": "0"}}
	},
	{
		"instructions": [
			{"mov": ["esp", "ebp"]}
		],
		"action": {"epilog-restore": {"restore": "RESTORE(esp)"}}
	},
	{
		"instructions": [
			{"pop": ["ebp"]},
			{"ret": []}
		],
		"action": {"epilog-return": {"size": "0"}}
	},
	{
		"instructions": [
			{"pop": ["ebp"]},
			{"ret": ["%hex%"]}
		],
		"action": {"epilog-return": {"size": "%hex%"}}
	},
	{
		"instructions": [
			{"xor":  ["e%a-c-d%x", "e%a-c-d%x"]},
			{"mov":  ["%a-c-d%l", "%src-operand%"]}
		],
		"action": {"tmpreg": {"dst": "e%a-c-d%x", "src": "(uint32)%src-operand%"}}
	},
	{
		"instructions": [
			{"xor":  ["e%a-c-d%x", "e%a-c-d%x"]},
			{"mov":  ["%a-c-d%x", "%src-operand%"]}
		],
		"action": {"tmpreg": {"dst": "e%a-c-d%x", "src": "(uint32)%src-operand%"}}
	},
	{
		"instructions": [
			{"xor":  ["e%a-c-d%x", "e%a-c-d%x"]},
			{"cmp":  ["%src-operand-left%", "%src-operand-right%"]},
			{"setne":  ["%a-c-d%l"]}
		],
		"action": {"tmpreg": {"dst": "e%a-c-d%x", "src": "(uint32)(I(%src-operand-left%) != I(%src-operand-right%))"}}
	},
	{
		"instructions": [
			{"mov":  ["%a-c-d%l", "%src-operand%"]},
			{"push":  ["e%a-c-d%x"]}
		],
		"action": {"stackarg": {"arg": "ARG(%src-operand%)"}}
	},
	{
		"instructions": [
			{"mov":  ["%a-c-d%x", "%src-operand%"]},
			{"push":  ["e%a-c-d%x"]}
		],
		"action": {"stackarg": {"arg": "ARG(%src-operand%)"}}
	},
	{
		"instructions": [
			{"mov":  ["[%eax-ecx-edx%]", "%hex-low%"]},
			{"mov":  ["[%eax-ecx-edx%+004h]", "%hex-high%"]}
		],
		"action": {"assignment": {"dst": "ACCESS(REGVALUE(%eax-ecx-edx%), 0, 8)", "src": "REAL64(%hex-high%, %hex-low%)"}}
	},
	{
		"instructions": [
			{"mov":  ["%mem-operand%", "%src-operand%"]}
		],
		"action": {"assignment": {"dst": "%mem-operand%", "src": "%src-operand%"}}
	},
	{
		"instructions": [
			{"mov":  ["%reg-operand%", "%src-operand%"]}
		],
		"action": {"tmpreg": {"dst": "%reg-operand%", "src": "%src-operand%"}}
	},
	{
		"instructions": [
			{"lea":  ["%eax-ecx-edx-dst%", "[%eax-ecx-edx-index%+%eax-ecx-edx-index%%offset%]"]}
		],
		"action": {"tmpreg": {"dst": "%eax-ecx-edx-dst%", "src": "2 * I(REGVALUE(%eax-ecx-edx-index%)) + %offset%"}}
	},
	{
		"instructions": [
			{"lea":  ["%eax-ecx-edx-dst%", "[%eax-ecx-edx-base%+%eax-ecx-edx-index%%offset%]"]}
		],
		"action": {"tmpreg": {"dst": "%eax-ecx-edx-dst%", "src": "I(REGVALUE(%eax-ecx-edx-base%)) + I(REGVALUE(%eax-ecx-edx-index%)) + %offset%"}}
	},
	{
		"instructions": [
			{"add":  ["%eax-ecx-edx%", "%src-operand%"]}
		],
		"action": {"tmpreg": {"dst": "%eax-ecx-edx%", "src": "I(REGVALUE(%eax-ecx-edx%)) + I(%src-operand%)"}}
	},
	{
		"instructions": [
			{"imul":  ["%eax-ecx-edx%", "%src-operand%", "%hex%"]}
		],
		"action": {"tmpreg": {"dst": "%eax-ecx-edx%", "src": "I(%hex%) * I(%src-operand%)"}}
	},
	{
		"instructions": [
			{"cdq":   []},
			{"idiv":  ["%src-operand%"]},
			{"mov":   ["eax", "%src-operand-left%"]},
			{"sub":   ["eax", "edx"]}
		],
		"action": {"tmpreg": {"dst": "eax", "src": "S(%src-operand-left%) - S(REGVALUE(eax)) % S(%src-operand%)"}}
	},
	{
		"instructions": [
			{"cdq":   []},
			{"idiv":  ["%src-operand%"]}
		],
		"action": {"tmpreg": {"dst": "eax", "src": "S(REGVALUE(eax)) / S(%src-operand%)"}}
	},
	{
		"instructions": [
			{"cdq":   []},
			{"sub":   ["eax", "edx"]},
			{"sar":   ["eax", "001h"]}
		],
		"action": {"tmpreg": {"dst": "eax", "src": "S(REGVALUE(eax)) / S(2)"}}
	},
	{
		"instructions": [
			{"xor":  ["%eax-ecx-edx%", "%eax-ecx-edx%"]}
		],
		"action": {"tmpreg": {"dst": "%eax-ecx-edx%", "src": "0x00000000"}}
	},
	{
		"instructions": [
			{"shl":  ["%eax-ecx-edx%", "001h"]}
		],
		"action": {"tmpreg": {"dst": "%eax-ecx-edx%", "src": "2 * I(REGVALUE(%eax-ecx-edx%))"}}
	},
	{
		"instructions": [
			{"cmp":  ["%src-operand-left%", "%src-operand-right%"]}
		],
		"actions": [
			{"tmpreg": {"dst": "cmpl", "src": "%src-operand-left%"}},
			{"tmpreg": {"dst": "cmpr", "src": "%src-operand-right%"}}
		]
	},
	{
		"instructions": [
			{"sbb":  ["%eax-ecx-edx%", "%eax-ecx-edx%"]},
			{"inc":  ["%eax-ecx-edx%"]}
		],
		"action": {"tmpreg": {"dst": "%eax-ecx-edx%", "src": "(uint32)(U(REGVALUE(cmpl)) >= U(REGVALUE(cmpr)))"}}
	},
	{
		"instructions": [
			{"push":  ["%src-operand%"]}
		],
		"action": {"stackarg": {"arg": "ARG(%src-operand%)"}}
	},
	{
		"instructions": [
			{"call":  ["%label%"]}
		],
		"action": {"call": {"address": "%label%"}}
	},
	{
		"instructions": [
			{"call":  ["%external%"]}
		],
		"action": {"call": {"name": "%external%"}}
	},
	{
		"instructions": [
			{"call":  ["%src-operand%"]}
		],
		"action": {"call": {"expression": "%src-operand%"}}
	},
	{
		"instructions": [
			{"add":  ["esp", "%hex%"]}
		],
		"action": {"addsp": {"offset": "%hex%"}}
	}
	]
}
